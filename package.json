{
  "name": "@vezironi/veyra-ui",
  "version": "0.1.1",
  "description": "Vue 3 UI component kit built with Tailwind CSS v4, with dark and light themes.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vezironi/veyra-ui.git"
  },
  "homepage": "https://github.com/vezironi/veyra-ui#readme",
  "bugs": {
    "url": "https://github.com/vezironi/veyra-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "ui-kit",
    "components",
    "tailwindcss",
    "dark-mode"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.58.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
